# med.ai configuration
#
# Copy to .env and fill in ONE provider. Everything else has a working
# default, so a minimal .env is three lines.
#
#   cp .env.example .env
#   docker compose up -d
#
# ---------------------------------------------------------------------------
# 1. Pick a provider  (required)
# ---------------------------------------------------------------------------
# One of: bedrock | gemini | openai | anthropic | nvidia
LLM_PROVIDER=bedrock

# --- AWS Bedrock ------------------------------------------------------------
# Credentials come from the normal AWS chain (~/.aws, or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY), not from a key here. docker-compose mounts ~/.aws
# into the container read-only.
AWS_REGION=us-east-1
BEDROCK_MODEL=deepseek.v3.2

# --- Google Gemini ----------------------------------------------------------
# Free tier is capped at 20 requests per DAY per model, which is not enough to
# finish one suite. Enable billing on the API project for real use.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI -----------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# --- Anthropic --------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- NVIDIA NIM -------------------------------------------------------------
# NVIDIA_API_KEY=
# NVIDIA_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# 2. Per-role overrides  (optional)
# ---------------------------------------------------------------------------
# Four roles: agent (plays the receptionist), patient (plays the caller),
# judge (grades transcripts), reflect (diagnoses failures, proposes fixes).
#
# Pointing the judge at a different vendor from the agent is worth doing: a
# model is a soft grader of its own output.
#
# JUDGE_PROVIDER=nvidia

# Per-role MODEL overrides use <PROVIDER>_MODEL_<ROLE>. Useful on tiers that
# cap requests per model, since spreading roles multiplies usable quota.
BEDROCK_MODEL_JUDGE=us.amazon.nova-lite-v1:0

# ---------------------------------------------------------------------------
# 3. Infrastructure  (defaults match docker-compose; leave alone locally)
# ---------------------------------------------------------------------------
# The API container gets these from docker-compose. They are here for running
# the CLI on the host, where the ports are published rather than internal.
DATABASE_URL=postgres://medai:medai@localhost:5434/medai

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=medai-traces
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# ---------------------------------------------------------------------------
# 4. Tuning  (optional)
# ---------------------------------------------------------------------------
# Scenarios run in parallel. Lower this if a provider rate-limits.
EVAL_CONCURRENCY=3

# Per-request timeout and retry budget. A provider that stalls rather than
# erroring will otherwise block a whole suite run.
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=8

# Minimum gap between requests to one provider. Only needed on rate-limited
# free tiers; 1 means no deliberate spacing.
# MIN_REQUEST_GAP_MS=1

# Improvement rounds attempted per `npm run loop`.
LOOP_ROUNDS=1

# Skip the LLM half of the safety screen and use the pattern floor only.
# Halves per-turn calls, but novel phrasings a word list cannot anticipate
# will be missed. Development convenience, never a production setting.
DETERMINISTIC_SAFETY_ONLY=false
